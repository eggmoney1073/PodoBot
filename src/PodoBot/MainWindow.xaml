<Window x:Class="PodoBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodoBot"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/PodoBot.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PodoBot" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="방송 운영 기능을 한 곳에서" Foreground="{StaticResource SubTextBrush}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#A7ABB4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="연결 안 됨" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="홈">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="WelcomeTitle" Text="치지직을 연결해 주세요" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock x:Name="WelcomeBody" Text="처음 한 번만 로그인하면 됩니다." Foreground="{StaticResource SubTextBrush}" FontSize="15" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="ChannelText" Margin="0,12,0,0" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="MainConnectButton" Style="{StaticResource PrimaryButton}" Content="치지직 연결하기" FontSize="16" Click="MainConnectButton_Click"/>
                                    <Button x:Name="DisconnectButton" Style="{StaticResource DangerButton}" Content="방송봇 끄기" FontSize="16" Visibility="Collapsed" Click="DisconnectButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OBS 룰렛" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="http://localhost:18766/roulette" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="미리보기" Click="PreviewRouletteButton_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="주소 복사" Click="CopyRouletteButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OBS 타이머" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="http://localhost:18766/timer" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButton}" Content="미리보기" Click="PreviewTimerButton_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="주소 복사" Click="CopyTimerButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="최근 동작" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="비우기" DockPanel.Dock="Right" Padding="12,6" Click="ClearLogButton_Click"/>
                                </DockPanel>
                                <TextBox x:Name="LogTextBox" Height="240" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#FAFAFC"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="명령어">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="채팅 명령어" FontSize="20" FontWeight="Bold"/><TextBlock Text="!명령어 / !commands는 활성 기능 목록을 자동 안내합니다." Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DataGrid x:Name="CommandsGrid"><DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="60"/>
                            <DataGridTextColumn Header="명령어" Binding="{Binding Trigger}" Width="130"/>
                            <DataGridTextColumn Header="답변" Binding="{Binding Response}" Width="*"/>
                            <DataGridTextColumn Header="전체 대기(초)" Binding="{Binding CooldownSeconds}" Width="110"/>
                            <DataGridTextColumn Header="개인 대기(초)" Binding="{Binding UserCooldownSeconds}" Width="110"/>
                            <DataGridTextColumn Header="권한" Binding="{Binding Permission}" Width="100"/>
                        </DataGrid.Columns></DataGrid>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="추가" Click="AddCommandButton_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteCommandButton_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="룰렛">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DataGrid x:Name="RoulettesGrid" SelectionChanged="RoulettesGrid_SelectionChanged"><DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="55"/>
                            <DataGridTextColumn Header="룰렛 이름" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="채팅 명령어" Binding="{Binding Trigger}" Width="120"/>
                            <DataGridTextColumn Header="결과 채팅" Binding="{Binding Response}" Width="*"/>
                            <DataGridTextColumn Header="전체 대기(초)" Binding="{Binding CooldownSeconds}" Width="105"/>
                            <DataGridTextColumn Header="개인 대기(초)" Binding="{Binding UserCooldownSeconds}" Width="105"/>
                            <DataGridTextColumn Header="권한" Binding="{Binding Permission}" Width="90"/>
                        </DataGrid.Columns></DataGrid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel><TextBlock x:Name="SelectedRouletteText" Text="룰렛 항목" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="RouletteTotalText" DockPanel.Dock="Right" FontWeight="Bold"/></DockPanel>
                            <DataGrid x:Name="RouletteItemsGrid" Grid.Row="2" CellEditEnding="RouletteItemsGrid_CellEditEnding"><DataGrid.Columns>
                                <DataGridTextColumn Header="당첨 내용" Binding="{Binding Text}" Width="*"/>
                                <DataGridTextColumn Header="확률 (%)" Binding="{Binding ChancePercent}" Width="140"/>
                                <DataGridCheckBoxColumn Header="한 번 더" Binding="{Binding IsReroll}" Width="100"/>
                            </DataGrid.Columns></DataGrid>
                        </Grid>
                    </Border>
                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="룰렛 추가" Click="AddRouletteButton_Click"/><Button Style="{StaticResource DangerButton}" Content="룰렛 삭제" Click="DeleteRouletteButton_Click"/></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryButton}" Content="항목 추가" Click="AddRouletteItemButton_Click"/><Button Style="{StaticResource DangerButton}" Content="항목 삭제" Click="DeleteRouletteItemButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/></StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="후원">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="후원 → 룰렛" FontSize="20" FontWeight="Bold"/><TextBlock Text="최소 금액과 포함 단어를 모두 만족하면 지정한 룰렛을 실행합니다. 예: 2000 이상 + 애교." Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}"><DataGrid x:Name="DonationRulesGrid"><DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="60"/>
                        <DataGridTextColumn Header="최소 금액" Binding="{Binding MinAmount}" Width="130"/>
                        <DataGridTextColumn Header="포함 단어" Binding="{Binding Keyword}" Width="180"/>
                        <DataGridTemplateColumn Header="실행 룰렛" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Roulettes, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding RouletteId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns></DataGrid></Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource SecondaryButton}" Content="규칙 추가" Click="AddDonationRuleButton_Click"/><Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteDonationRuleButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="반복 안내">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="반복 안내" FontSize="20" FontWeight="Bold"/><TextBlock Text="방송 중 일정 간격마다 같은 안내 메시지를 자동 전송합니다." Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}"><DataGrid x:Name="RepeatingMessagesGrid"><DataGrid.Columns><DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="60"/><DataGridTextColumn Header="보낼 메시지" Binding="{Binding Message}" Width="*"/><DataGridTextColumn Header="몇 분마다" Binding="{Binding IntervalMinutes}" Width="140"/></DataGrid.Columns></DataGrid></Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource SecondaryButton}" Content="추가" Click="AddRepeatingMessageButton_Click"/><Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteRepeatingMessageButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="타이머">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="카운트다운 타이머" FontSize="20" FontWeight="Bold"/><TextBlock Text="시간/분/초 단위로 표시하고 종료 후 10초 뒤 화면에서 사라집니다." Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="CountdownStatusText" Grid.Column="1" Text="대기 중" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}"><DataGrid x:Name="CountdownTimersGrid"><DataGrid.Columns><DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="시간" Binding="{Binding Hours}" Width="80"/><DataGridTextColumn Header="분" Binding="{Binding Minutes}" Width="80"/><DataGridTextColumn Header="초" Binding="{Binding Seconds}" Width="80"/><DataGridTextColumn Header="종료 메시지" Binding="{Binding FinishMessage}" Width="*"/></DataGrid.Columns></DataGrid></Border>
                    <DockPanel Grid.Row="3" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="타이머 추가" Click="AddCountdownTimerButton_Click"/><Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteCountdownTimerButton_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SecondaryButton}" Content="중지" Click="StopCountdownTimerButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="선택 타이머 시작" Click="StartCountdownTimerButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/></StackPanel></DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="횟수">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="횟수 카운터" FontSize="20" FontWeight="Bold"/><TextBlock Text="사망 횟수처럼 숫자를 명령어로 누적하는 기능입니다." Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}"><DataGrid x:Name="CountersGrid"><DataGrid.Columns><DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="60"/><DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="160"/><DataGridTextColumn Header="명령어" Binding="{Binding Trigger}" Width="140"/><DataGridTextColumn Header="현재 값" Binding="{Binding Value}" Width="100"/><DataGridTextColumn Header="변화 값" Binding="{Binding Step}" Width="100"/><DataGridTextColumn Header="권한" Binding="{Binding Permission}" Width="110"/></DataGrid.Columns></DataGrid></Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource SecondaryButton}" Content="추가" Click="AddCounterButton_Click"/><Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteCounterButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="노래방 책">
                <Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="노래방 책" FontSize="20" FontWeight="Bold"/><TextBlock Text="곡을 등록하고 !노래책 또는 !노래검색 검색어로 조회할 수 있습니다." Foreground="{StaticResource SubTextBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}"><DataGrid x:Name="SongBookGrid"><DataGrid.Columns><DataGridTextColumn Header="기기" Binding="{Binding Provider}" Width="90"/><DataGridTextColumn Header="번호" Binding="{Binding Number}" Width="110"/><DataGridTextColumn Header="곡명" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="가수" Binding="{Binding Artist}" Width="220"/></DataGrid.Columns></DataGrid></Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Style="{StaticResource SecondaryButton}" Content="곡 추가" Click="AddSongButton_Click"/><Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteSongButton_Click"/><Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="계정" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="AccountText" Text="치지직에 연결되지 않았습니다." Margin="0,10,0,12"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Content="치지직 다시 로그인" Click="LoginButton_Click"/><Button Style="{StaticResource DangerButton}" Content="로그아웃" Click="LogoutButton_Click"/></StackPanel></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="후원 기능 권한" FontSize="20" FontWeight="Bold"/><TextBlock Text="후원 룰렛을 쓰려면 CHZZK Developers에서 '후원 조회' 스코프를 추가하고 PodoBot에서 다시 로그인하세요." TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" Margin="0,8,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="데이터" FontSize="20" FontWeight="Bold"/><Button Style="{StaticResource SecondaryButton}" Content="데이터 폴더 열기" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenDataFolderButton_Click"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
