<Window x:Class="PodoBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodoBot"
        Width="1120"
        Height="760"
        MinWidth="960"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/PodoBot.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="PodoBot"
                           FontSize="30"
                           FontWeight="Bold"/>
                <TextBlock Text="방송할 때 필요한 기능만 간단하게"
                           Foreground="{StaticResource SubTextBrush}"
                           FontSize="14"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot"
                             Width="10" Height="10"
                             Fill="#A7ABB4"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                               Text="연결 안 됨"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0">
            <TabItem Header="홈">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="WelcomeTitle"
                                               Text="치지직을 연결해 주세요"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                    <TextBlock x:Name="WelcomeBody"
                                               Text="처음 한 번만 로그인하면 다음부터는 바로 방송봇을 켤 수 있어요."
                                               Foreground="{StaticResource SubTextBrush}"
                                               FontSize="15"
                                               Margin="0,8,0,0"/>
                                    <TextBlock x:Name="ChannelText"
                                               Text=""
                                               FontSize="14"
                                               Margin="0,12,0,0"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="MainConnectButton"
                                            Style="{StaticResource PrimaryButton}"
                                            Content="치지직 연결하기"
                                            FontSize="16"
                                            Click="MainConnectButton_Click"/>
                                    <Button x:Name="DisconnectButton"
                                            Style="{StaticResource DangerButton}"
                                            Content="방송봇 끄기"
                                            FontSize="16"
                                            Visibility="Collapsed"
                                            Click="DisconnectButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="방송 준비"
                                               FontSize="18"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="설정한 명령어, 룰렛, 타이머는 방송봇을 켜면 자동으로 동작합니다."
                                               Foreground="{StaticResource SubTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,14"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="OBS 룰렛 화면 미리보기"
                                            HorizontalAlignment="Left"
                                            Click="PreviewOverlayButton_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="OBS 룰렛 주소"
                                               FontSize="18"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="http://localhost:18766/roulette"
                                               Foreground="{StaticResource SubTextBrush}"
                                               Margin="0,8,0,14"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="주소 복사"
                                            HorizontalAlignment="Left"
                                            Click="CopyOverlayButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="최근 동작"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               DockPanel.Dock="Left"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="비우기"
                                            DockPanel.Dock="Right"
                                            Padding="12,6"
                                            Click="ClearLogButton_Click"/>
                                </DockPanel>
                                <TextBox x:Name="LogTextBox"
                                         Height="220"
                                         Margin="0,12,0,0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Background="#FAFAFC"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="명령어">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="채팅 명령어"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="시청자가 !명령어를 입력하면 정해둔 문장을 자동으로 답합니다."
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DataGrid x:Name="CommandsGrid">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="60"/>
                                <DataGridTextColumn Header="명령어" Binding="{Binding Trigger}" Width="130"/>
                                <DataGridTextColumn Header="답변" Binding="{Binding Response}" Width="*"/>
                                <DataGridTextColumn Header="전체 대기(초)" Binding="{Binding CooldownSeconds}" Width="110"/>
                                <DataGridTextColumn Header="개인 대기(초)" Binding="{Binding UserCooldownSeconds}" Width="110"/>
                                <DataGridTextColumn Header="사용 권한" Binding="{Binding Permission}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="사용 권한: 전체 / 매니저 / 스트리머"
                                   Foreground="{StaticResource SubTextBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="추가" Click="AddCommandButton_Click"/>
                            <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteCommandButton_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="룰렛">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="확률 룰렛"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Text="당첨 내용과 확률만 정하면 됩니다. 합계는 100%로 맞춰 주세요."
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="채팅 명령어"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SubTextBrush}"/>
                                <TextBox x:Name="RouletteTriggerTextBox" Width="100"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DataGrid x:Name="RouletteGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="당첨 내용" Binding="{Binding Text}" Width="*"/>
                                <DataGridTextColumn Header="확률 (%)" Binding="{Binding ChancePercent}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock x:Name="RouletteTotalText"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="추가" Click="AddRouletteButton_Click"/>
                            <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteRouletteButton_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="미리보기" Click="PreviewOverlayButton_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="타이머">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="반복 안내"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="방송 중 몇 분마다 안내 문장을 자동으로 보냅니다."
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DataGrid x:Name="TimersGrid">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="60"/>
                                <DataGridTextColumn Header="보낼 메시지" Binding="{Binding Message}" Width="*"/>
                                <DataGridTextColumn Header="몇 분마다" Binding="{Binding IntervalMinutes}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="추가" Click="AddTimerButton_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteTimerButton_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="카운터">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="카운터"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="사망 횟수처럼 방송 중 자주 세는 값을 명령어 하나로 기록합니다."
                                       Foreground="{StaticResource SubTextBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DataGrid x:Name="CountersGrid">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="60"/>
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="160"/>
                                <DataGridTextColumn Header="명령어" Binding="{Binding Trigger}" Width="140"/>
                                <DataGridTextColumn Header="현재 값" Binding="{Binding Value}" Width="100"/>
                                <DataGridTextColumn Header="변화 값" Binding="{Binding Step}" Width="100"/>
                                <DataGridTextColumn Header="사용 권한" Binding="{Binding Permission}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="추가" Click="AddCounterButton_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="DeleteCounterButton_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="저장" Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="설정">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="계정"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="AccountText"
                                           Text="치지직에 연결되지 않았습니다."
                                           Margin="0,10,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="치지직 다시 로그인"
                                            Click="LoginButton_Click"/>
                                    <Button Style="{StaticResource DangerButton}"
                                            Content="로그아웃"
                                            Click="LogoutButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="데이터"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Text="명령어, 룰렛, 타이머 설정은 이 PC에만 저장됩니다."
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,5,0,12"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="설정 폴더 열기"
                                        HorizontalAlignment="Left"
                                        Click="OpenDataFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="OBS"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock Text="브라우저 소스에 아래 주소를 한 번만 등록하면 됩니다."
                                           Foreground="{StaticResource SubTextBrush}"
                                           Margin="0,5,0,8"/>
                                <TextBlock Text="http://localhost:18766/roulette"
                                           FontWeight="SemiBold"/>
                                <Button Style="{StaticResource SecondaryButton}"
                                        Content="주소 복사"
                                        HorizontalAlignment="Left"
                                        Margin="4,12,4,4"
                                        Click="CopyOverlayButton_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
